      [
        "table",
        "assignment_submissions",
        "assignment_submissions",
        "CREATE TABLE assignment_submissions (\n\tsubmission_id VARCHAR(36) NOT NULL, \n\tassignment_id VARCHAR(36) NOT NULL, \n\tstudent_id VARCHAR(36) NOT NULL, \n\tcontent TEXT, \n\tfile_path VARCHAR(500), \n\tfile_name VARCHAR(200), \n\tsubmitted_at DATETIME, \n\tis_late BOOLEAN, \n\tscore INTEGER, \n\tfeedback TEXT, \n\tgraded_at DATETIME, \n\tgraded_by VARCHAR(36), \n\tstatus VARCHAR(20), \n\tcreated_at DATETIME, \n\tupdated_at DATETIME, \n\tPRIMARY KEY (submission_id), \n\tCONSTRAINT unique_assignment_submission UNIQUE (assignment_id, student_id), \n\tFOREIGN KEY(assignment_id) REFERENCES assignments (assignment_id) ON DELETE CASCADE, \n\tFOREIGN KEY(student_id) REFERENCES students (student_id) ON DELETE CASCADE, \n\tFOREIGN KEY(graded_by) REFERENCES users (user_id) ON DELETE SET NULL\n)"
      ],
      [
        "table",
        "assignments",
        "assignments",
        "CREATE TABLE assignments (\n\tassignment_id VARCHAR(36) NOT NULL, \n\ttitle VARCHAR(200) NOT NULL, \n\tdescription TEXT NOT NULL, \n\tcourse_id VARCHAR(36), \n\tteacher_id VARCHAR(36) NOT NULL, \n\ttarget_student_id VARCHAR(36), \n\tassignment_type VARCHAR(20), \n\tdifficulty VARCHAR(20), \n\tmax_score INTEGER, \n\tdue_date DATETIME NOT NULL, \n\tlate_submission_allowed BOOLEAN, \n\tlate_penalty_percent INTEGER, \n\tsubmission_type VARCHAR(20), \n\tstatus VARCHAR(20), \n\tis_published BOOLEAN, \n\ttotal_submissions INTEGER, \n\tgraded_submissions INTEGER, \n\tcreated_at DATETIME, \n\tupdated_at DATETIME, \n\tPRIMARY KEY (assignment_id), \n\tFOREIGN KEY(course_id) REFERENCES courses (course_id) ON DELETE CASCADE, \n\tFOREIGN KEY(teacher_id) REFERENCES users (user_id) ON DELETE CASCADE, \n\tFOREIGN KEY(target_student_id) REFERENCES students (student_id) ON DELETE SET NULL\n)"
      ],
      [
        "table",
        "attendance",
        "attendance",
        "CREATE TABLE attendance (\n\tattendance_id VARCHAR(36) NOT NULL, \n\tsession_id VARCHAR(36) NOT NULL, \n\tstudent_id VARCHAR(36) NOT NULL, \n\tenrollment_id VARCHAR(36) NOT NULL, \n\tstatus VARCHAR(20), \n\tchecked_at DATETIME, \n\tchecked_by VARCHAR(36), \n\tcheckin_method VARCHAR(20), \n\tparticipation_score INTEGER, \n\tcomprehension_score INTEGER, \n\tadjustment_created BOOLEAN, \n\tnotes TEXT, \n\tcreated_at DATETIME, \n\tupdated_at DATETIME, \n\tPRIMARY KEY (attendance_id), \n\tFOREIGN KEY(session_id) REFERENCES course_sessions (session_id) ON DELETE CASCADE, \n\tFOREIGN KEY(student_id) REFERENCES students (student_id) ON DELETE CASCADE, \n\tFOREIGN KEY(enrollment_id) REFERENCES course_enrollments (enrollment_id) ON DELETE CASCADE, \n\tFOREIGN KEY(checked_by) REFERENCES users (user_id) ON DELETE SET NULL\n)"
      ],
      [
        "table",
        "br_assignment_heads",
        "br_assignment_heads",
        "CREATE TABLE br_assignment_heads (\n\tsubmission_id TEXT NOT NULL, \n\trevision_id TEXT NOT NULL, \n\tgeneration INTEGER NOT NULL, \n\tlegacy_digest TEXT NOT NULL, \n\tPRIMARY KEY (submission_id), \n\tCHECK (typeof(generation)='integer' AND generation>=1), \n\tCHECK (length(legacy_digest)=64 AND legacy_digest NOT GLOB '*[^0-9a-f]*'), \n\tFOREIGN KEY(submission_id) REFERENCES assignment_submissions (submission_id) ON DELETE RESTRICT, \n\tCONSTRAINT fk_br_head_revision FOREIGN KEY(submission_id, revision_id) REFERENCES br_assignment_revisions (submission_id, revision_id) ON DELETE RESTRICT\n)"
      ],
      [
        "table",
        "br_assignment_outbox",
        "br_assignment_outbox",
        "CREATE TABLE br_assignment_outbox (\n\tevent_id TEXT NOT NULL, \n\tcommand_id TEXT NOT NULL, \n\trecipient_user_id TEXT NOT NULL, \n\tnotification_id TEXT NOT NULL, \n\tevent_type TEXT NOT NULL, \n\tpayload TEXT NOT NULL, \n\tdelivery_state TEXT NOT NULL, \n\tattempt_count INTEGER NOT NULL, \n\tcreated_at TEXT NOT NULL, \n\tPRIMARY KEY (event_id), \n\tCHECK (event_type='assignment_submitted'), \n\tCHECK (delivery_state='pending'), \n\tCHECK (typeof(attempt_count)='integer' AND attempt_count=0), \n\tCONSTRAINT uq_br_outbox_event UNIQUE (command_id, recipient_user_id, event_type), \n\tFOREIGN KEY(command_id) REFERENCES br_assignment_receipts (command_id) ON DELETE RESTRICT, \n\tFOREIGN KEY(recipient_user_id) REFERENCES users (user_id) ON DELETE RESTRICT, \n\tUNIQUE (notification_id), \n\tFOREIGN KEY(notification_id) REFERENCES notifications (notification_id) ON DELETE RESTRICT\n)"
      ],
      [
        "table",
        "br_assignment_receipts",
        "br_assignment_receipts",
        "CREATE TABLE br_assignment_receipts (\n\tcommand_id TEXT NOT NULL, \n\tactor_user_id TEXT NOT NULL, \n\tidempotency_key TEXT NOT NULL, \n\tassignment_id TEXT NOT NULL, \n\tsubmission_id TEXT NOT NULL, \n\trevision_id TEXT NOT NULL, \n\trequest_digest TEXT NOT NULL, \n\tresponse_status INTEGER NOT NULL, \n\tresponse_body TEXT NOT NULL, \n\tcommitted_at TEXT NOT NULL, \n\tPRIMARY KEY (command_id), \n\tCHECK (length(request_digest)=64 AND request_digest NOT GLOB '*[^0-9a-f]*'), \n\tCHECK (length(idempotency_key) BETWEEN 1 AND 128), \n\tCHECK (response_status IN (200,201)), \n\tCONSTRAINT uq_br_actor_key UNIQUE (actor_user_id, idempotency_key), \n\tCONSTRAINT uq_br_receipt_revision UNIQUE (revision_id), \n\tFOREIGN KEY(actor_user_id) REFERENCES users (user_id) ON DELETE RESTRICT, \n\tFOREIGN KEY(assignment_id) REFERENCES assignments (assignment_id) ON DELETE RESTRICT, \n\tFOREIGN KEY(submission_id) REFERENCES assignment_submissions (submission_id) ON DELETE RESTRICT, \n\tCONSTRAINT fk_br_receipt_revision FOREIGN KEY(submission_id, revision_id) REFERENCES br_assignment_revisions (submission_id, revision_id) ON DELETE RESTRICT\n)"
      ],
      [
        "table",
        "br_assignment_revisions",
        "br_assignment_revisions",
        "CREATE TABLE br_assignment_revisions (\n\trevision_id TEXT NOT NULL, \n\tsubmission_id TEXT NOT NULL, \n\trevision_no INTEGER NOT NULL, \n\tparent_revision_id TEXT, \n\tactor_user_id TEXT NOT NULL, \n\tcontent TEXT NOT NULL, \n\tfile_manifest TEXT NOT NULL, \n\tpayload_digest TEXT NOT NULL, \n\tlegacy_snapshot TEXT NOT NULL, \n\tlegacy_digest TEXT NOT NULL, \n\tenrollment_id TEXT NOT NULL, \n\tcourse_id TEXT NOT NULL, \n\tsession_id TEXT, \n\tscope_state TEXT NOT NULL, \n\tprogram_id TEXT, \n\tedition_id TEXT, \n\trubric_id TEXT, \n\tcaptured_at TEXT NOT NULL, \n\tPRIMARY KEY (revision_id), \n\tCHECK (typeof(revision_no)='integer' AND revision_no>=1), \n\tCHECK (scope_state IN ('explicit_scope_checked','unknown')), \n\tCHECK (program_id IS NULL AND edition_id IS NULL AND rubric_id IS NULL), \n\tCHECK (length(payload_digest)=64 AND payload_digest NOT GLOB '*[^0-9a-f]*'), \n\tCHECK (length(legacy_digest)=64 AND legacy_digest NOT GLOB '*[^0-9a-f]*'), \n\tCONSTRAINT uq_br_revision_no UNIQUE (submission_id, revision_no), \n\tCONSTRAINT uq_br_revision_target UNIQUE (submission_id, revision_id), \n\tFOREIGN KEY(submission_id) REFERENCES assignment_submissions (submission_id) ON DELETE RESTRICT, \n\tFOREIGN KEY(actor_user_id) REFERENCES users (user_id) ON DELETE RESTRICT, \n\tFOREIGN KEY(enrollment_id) REFERENCES course_enrollments (enrollment_id) ON DELETE RESTRICT, \n\tFOREIGN KEY(course_id) REFERENCES courses (course_id) ON DELETE RESTRICT, \n\tFOREIGN KEY(session_id) REFERENCES course_sessions (session_id) ON DELETE RESTRICT, \n\tCONSTRAINT fk_br_revision_parent FOREIGN KEY(submission_id, parent_revision_id) REFERENCES br_assignment_revisions (submission_id, revision_id) ON DELETE RESTRICT\n)"
      ],
      [
        "table",
